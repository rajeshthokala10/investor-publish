{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim",
  "description": "Normalised, verifiable claim passed between pipeline stages (data/runs/<edition>/*.json).",
  "type": "object",
  "required": ["claim_id", "statement", "claim_type", "subject", "corridor", "region", "property_type", "url", "domain",
               "publisher", "tier", "group", "interested_party", "published_at", "event_date", "retrieved_at",
               "excerpt", "metric", "value", "unit", "price_basis", "price_kind", "infra_stage", "verification_status",
               "confidence", "confidence_reason", "flags", "origin"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^C-[0-9a-f]{10}$"},
    "statement": {"type": "string", "minLength": 1},
    "claim_type": {"type": "string"},
    "subject": {"type": "string"},
    "corridor": {"type": "string"},
    "region": {"type": "string"},
    "property_type": {"type": "string"},
    "url": {"type": "string", "pattern": "^https?://"},
    "domain": {"type": "string"},
    "publisher": {"type": "string"},
    "tier": {"type": "string"},
    "group": {"type": "string"},
    "interested_party": {"type": "boolean"},
    "published_at": {"type": ["string", "null"]},
    "event_date": {"type": ["string", "null"]},
    "retrieved_at": {"type": "string"},
    "excerpt": {"type": "string"},
    "metric": {"type": "string"},
    "value": {"type": ["number", "null"]},
    "unit": {"type": ["string", "null"]},
    "price_basis": {"type": "string"},
    "price_kind": {"type": "string"},
    "infra_stage": {"type": "string"},
    "verification_status": {"enum": ["verified_primary", "corroborated", "single_source", "interested_party_claim",
                                     "unverified", "contradicted", "pending"]},
    "confidence": {"enum": ["High", "Medium", "Low", "pending"]},
    "confidence_reason": {"type": "string"},
    "flags": {"type": "array", "items": {"type": "string"}},
    "origin": {"type": "string"}
  }
}
